class Button  {
  float x, y, w, h;
  String label;
  color baseColor;
  color hoverColor;
  color textColor;
  PFont font;

  Button(float x, float y, float w, float h, String label, 
         color baseColor, color textColor, PFont font) {

    this.x = x;
    this.y = y;
    this.w = w;
    this.h = h;
    this.label = label;  
    this.baseColor = baseColor;
    this.hoverColor = lerpColor(baseColor, color(255), 0.2);
    this.textColor = textColor;
    this.font = font;
  }

  void display() {
    noStroke();
    fill(isHovering() ? hoverColor : baseColor);
    rect(x, y, w, h, 10);

    fill(textColor);
    textFont(font);
    textAlign(CENTER, CENTER);
    text(label, x + w / 2, y + h / 2);
  }

  boolean isHovering() {
    return mouseX >= x && mouseX <= x + w &&
           mouseY >= y && mouseY <= y + h;
  }
}
